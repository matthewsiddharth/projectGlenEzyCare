<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/profile_icon_description"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_profile" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/hospital_banner"
            android:scaleType="centerCrop"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/hospital_banner_description"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to GlenEzyCare"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnQueue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Get Queue Ticket"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnQueueStatus"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View Queue Status"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnAppointment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Book Appointment"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Appointment History"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="15dp"/>

    </LinearLayout>

</ScrollView>
